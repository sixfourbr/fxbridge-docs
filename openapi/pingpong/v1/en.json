{
  "openapi": "3.1.0",
  "info": {
    "title": "Ping-Pong API",
    "version": "1.0.0",
    "description": "Demo API to check your integration's connectivity with FXBridge environments."
  },
  "servers": [
    {
      "url": "https://sandbox.fxbridge.com.br",
      "description": "Sandbox"
    },
    {
      "url": "https://api.fxbridge.com.br",
      "description": "Production"
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "Ping",
      "description": "Connectivity check."
    }
  ],
  "paths": {
    "/v1/ping": {
      "get": {
        "operationId": "getPing",
        "summary": "Check connectivity",
        "description": "Returns `pong` and the current server time in UTC. No authentication required.",
        "tags": [
          "Ping"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Service available.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pong"
                },
                "example": {
                  "message": "pong",
                  "timestamp": "2026-11-19T08:57:35Z"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pong": {
        "type": "object",
        "description": "Connectivity check response.",
        "required": [
          "message",
          "timestamp"
        ],
        "properties": {
          "message": {
            "type": "string",
            "description": "Always `pong`.",
            "enum": [
              "pong"
            ],
            "example": "pong"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Server time at the moment of the response, in UTC (ISO 8601).",
            "example": "2026-11-19T08:57:35Z"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "description": "Problem details in the RFC 9457 format (Problem Details for HTTP APIs). Additional members (extensions) may be included depending on the API.",
        "required": [
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference",
            "description": "URI that identifies the problem type. When absent, `about:blank` is assumed.",
            "default": "about:blank",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "description": "Short, human-readable summary of the problem type.",
            "example": "Internal Server Error"
          },
          "status": {
            "type": "integer",
            "description": "HTTP status code generated by the server for this occurrence.",
            "minimum": 100,
            "maximum": 599,
            "example": 500
          },
          "detail": {
            "type": "string",
            "description": "Human-readable explanation specific to this occurrence of the problem.",
            "example": "An unexpected error occurred while processing the request."
          },
          "instance": {
            "type": "string",
            "format": "uri-reference",
            "description": "URI that identifies this specific occurrence of the problem.",
            "example": "/v1/ping"
          }
        }
      }
    },
    "responses": {
      "InternalServerError": {
        "description": "Unexpected internal server error.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            },
            "example": {
              "type": "about:blank",
              "title": "Internal Server Error",
              "status": 500,
              "detail": "An unexpected error occurred while processing the request."
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Service temporarily unavailable. Try again later.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            },
            "example": {
              "type": "about:blank",
              "title": "Service Unavailable",
              "status": 503,
              "detail": "The service is temporarily unavailable."
            }
          }
        }
      }
    }
  }
}