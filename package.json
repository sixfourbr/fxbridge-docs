{
  "name": "fxbridge-docs",
  "private": true,
  "description": "Portal de documentação de APIs da FXBridge (Mintlify)",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0 <25"
  },
  "scripts": {
    "dev": "mint dev",
    "lint:openapi": "redocly lint",
    "bundle": "redocly bundle",
    "check:bundle": "redocly bundle && git diff --exit-code -- openapi/",
    "check:parity": "node scripts/check-spec-parity.mjs",
    "check:translations": "node scripts/check-translations.mjs",
    "check:public": "node scripts/check-public-only.mjs",
    "check:breaking": "node scripts/check-breaking.mjs",
    "validate": "mint validate",
    "links": "mint broken-links --check-anchors",
    "a11y": "mint a11y",
    "check": "npm run lint:openapi && npm run check:bundle && npm run check:parity && npm run check:translations && npm run check:public && npm run validate && npm run links"
  },
  "devDependencies": {
    "@redocly/cli": "2.80.0",
    "mint": "4.3.67"
  }
}
